# Round 1 LangSmith monitoring notebook (langsmith/langsmith_monitoring_sample.ipynb)
OPENAI_API_KEY=
LANGSMITH_API_KEY=

# n8n instance config (set in ~/.config/n8n/docker-compose.yml on the host running the MVP, not in this repo)
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=chleo-booking-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# WEBHOOK_URL=https://<your-n8n-host>/

# Airtable, Google Calendar, Twilio, Resend, and the n8n-side OpenAI model are configured as
# n8n credentials through the n8n UI/API, not as env vars in this repo. See mvp_documentation.md.
