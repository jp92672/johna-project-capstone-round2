    {
      "parameters": {
        "promptType": "define",
        "text": "=It has been {{ Math.floor(-1 * DateTime.fromISO($json.fields['Last Visit Date']).diffNow('days').days / 7) }} weeks since {{ $json.fields.Name }}'s last visit to Chleo Hair Studio. Write a short, warm message inviting them back, structured as exactly three blocks separated by a blank line each: (1) \"Hi {{ $json.fields.Name }},\" alone on its own line, (2) the message body as one paragraph mentioning naturally that it's been that long since their last visit (phrase the number naturally, e.g. \"a couple months\" or \"a few weeks\") and inviting them to book again, no discounts or promises, (3) a two-line sign-off: a closing word like \"Warmly,\" on its own line, then \"The Chleo Hair Studio Team\" on the next line (a real line break between them, never a comma joining them onto one line). Never use an em dash anywhere in the message; use a period or comma instead. Keep the total under 50 words. Reply with only the message text, nothing else.",
        "options": {
          "systemMessage": "You draft short client outreach messages for Chleo Hair Studio, a premium hair salon. Sign off as \"The Chleo Hair Studio Team\" if you sign off at all. Never leave placeholder brackets like [Salon Name] in the output, always use the real name. Never invent discounts, availability, or claims you were not given. Never use an em dash (—) anywhere; use a period or comma instead."
        }
      },
