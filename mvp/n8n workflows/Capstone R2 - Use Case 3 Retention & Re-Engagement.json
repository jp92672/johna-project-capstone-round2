        "jsCode": "const appt = $('Get Upcoming Confirmed Appointments').item.json.fields;\nconst client = $json.fields;\nconst start = DateTime.fromISO(appt['Start Time']).setZone('Europe/Berlin');\nconst dateStr = start.toFormat('cccc, LLLL d');\nconst timeStr = start.toFormat('h:mm a');\nconst messageHtml = '<p style=\"margin:0 0 16px 0;\">Hi ' + client.Name + ',</p><p style=\"margin:0 0 16px 0;\">This is a reminder that your ' + appt.Service + ' appointment is coming up tomorrow, ' + dateStr + ' at ' + timeStr + ' (Berlin time).</p><p style=\"margin:0 0 16px 0;\">Cancellation Policy: We require 24 hours notice for cancellations or rescheduling. Appointments cancelled within 24 hours, or missed without notice, will incur a 50% late cancellation/no-show fee.</p><p style=\"margin:0;\">Warmly,<br>The Chleo Hair Studio Team</p>';\nreturn { json: { clientEmail: client.Email, messageHtml, subject: 'Reminder: your appointment tomorrow at Chleo Hair Studio' } };"
      },
